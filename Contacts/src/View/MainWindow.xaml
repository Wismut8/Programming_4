<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="533">
    <Grid Margin="15,15,15,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="369*"/>
            <RowDefinition Height="35*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <GroupBox x:Name="ReadContactGroupBox" Header="Read Contact" Margin="5,3,3,3" Grid.Column="1" Grid.ColumnSpan="3">
            <WrapPanel>
                <Label x:Name="NameLabel" Content="Name:" Width="232" Height="25.96"/>
                <TextBlock x:Name="NameTextBlock" TextWrapping="Wrap" Width="222" Height="22" Margin="5,0,0,0" FontWeight="Bold"
                    Text="{Binding FullName}"/>
                <Label x:Name="PhoneNumberLabel" Content="Phone number:" Width="232"/>
                <TextBlock x:Name="PhoneNumberTextBlock" TextWrapping="Wrap" Height="22" Width="227" Margin="5,0,0,0" FontWeight="Bold"
                    Text="{Binding PhoneNumber}"/>
                <Label x:Name="EmailLabel" Content="Email:" Width="232"/>
                <TextBlock x:Name="EmailTextBlock" TextWrapping="Wrap" Width="232" Height="22" Margin="5,0,0,0" FontWeight="Bold"
                     Text="{Binding Email}"/>
            </WrapPanel>
        </GroupBox>
        <GroupBox x:Name="EditContactGroupBox" Header="Edit Contact" Margin="3,3,5,3">
            <WrapPanel>
                <Label x:Name="NameEditLabel" Content="Name:" Width="231" Height="25.96"/>
                <TextBox x:Name="NameEditTextBox" TextWrapping="Wrap" Width="217" Height="22" Margin="5,0,0,0"
                    Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
                <Label x:Name="PhoneNumberTextBox" Content="Phone number:" Width="231"/>
                <TextBox x:Name="PhoneNumberTextBox1" TextWrapping="Wrap" Width="217" Height="22" Margin="5,0,0,0"
                    Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
                <Label x:Name="EmailEditLabel" Content="Email:" Width="232"/>
                <TextBox x:Name="EmailEditTextBox" TextWrapping="Wrap" Width="217" Height="22" Margin="5,0,0,0"
                    Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
            </WrapPanel>
        </GroupBox>
        <Button x:Name="SaveButton" Command="{Binding SaveCommand}" Grid.Column="2" Content="Save" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Center" Width="84" Height="33" Margin="3,3,3,3" Click="Button_Click"/>
        <Button x:Name="LoadButton" Command="{Binding LoadCommand}" Grid.Column="3" Content="Load" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Center" Width="84" Height="33" Margin="3,3,3,3"/>

    </Grid>
</Window>
