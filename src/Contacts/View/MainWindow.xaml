<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:e="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:View.ViewModel"
        mc:Ignorable="d"
        Title="Contacts" Height="432" Width="600">


    <Window.DataContext>
        <vm:MainVM/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    
    <e:Interaction.Triggers>
        <e:EventTrigger EventName="Closing">
            <e:InvokeCommandAction Command="{Binding SaveInFileCommand}"/>
        </e:EventTrigger>
    </e:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F8F8F8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label  
                    Grid.Row="0"
                    Content="Find:" 
                    HorizontalAlignment="Left" 
                    Width="40"/>

                <TextBox 
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    Margin="40,0,0,0"/>

                <ListBox
                    Grid.Row="1"
                    Height="Auto"
                    ItemsSource="{Binding Contacts}"
                    SelectedItem="{Binding SelectedContact, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FullName}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <GridSplitter 
            Grid.Column="1" 
            Background="White"
            HorizontalAlignment="Center"
            Width="3"/>

        <Grid Grid.Column="0" Grid.Row="1" Background="#F8F8F8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Add" 
                    Command="{Binding AddCommand}"
                    Height="25" 
                    Margin="8,3,3,8"
                    Grid.Column="0"/>

            <Button Content="Edit" 
                    Command="{Binding EditCommand}"
                    Height="25" 
                    Margin="3,3,3,8"
                    Grid.Column="1"
                    IsEnabled="{Binding CanEditDelete}"/>

            <Button Content="Remove" 
                    Command="{Binding RemoveCommand}"
                    Height="25" 
                    Margin="3,3,8,8"
                    Grid.Column="2"
                    IsEnabled="{Binding CanEditDelete}"/>
        </Grid>

        <Grid Grid.Column="2" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Image 
                HorizontalAlignment="Left" 
                Height="100" 
                Width="100" 
                Margin="8,35,8,0" 
                VerticalAlignment="Top"  
                Source="/contact photo.png"/>

            <StackPanel Grid.Column="1" Margin="8">
                <Label Content="Name:"/>
                <TextBox Text="{Binding FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsReadOnly}"
                         Margin="5,0,0,0"/>

                <Label Content="Phone Number:"/>
                <TextBox Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsReadOnly}"
                         Margin="5,0,0,0"/>

                <Label Content="Email:"/>
                <TextBox Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsReadOnly}"
                         Margin="5,0,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" 
                    Grid.Row="1"
                    Content="Apply" 
                    Command="{Binding ApplyCommand}"
                    Height="25" 
                    Width="75" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Margin="8,50,0,0"
                    Visibility="{Binding IsApplyVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</Window>