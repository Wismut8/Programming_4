<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:e="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:View"
        xmlns:controls="clr-namespace:View.Controls"
        mc:Ignorable="d"
        Title="Contacts" Height="432" Width="600">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <DataTemplate x:Key="ContactDataTemplate">
            <StackPanel Orientation="Horizontal" Margin="3">

                <Image 
                Source="/contact photo.png" 
                Width="30" 
                Height="30"
                Margin="0,0,5,0"
                VerticalAlignment="Center"/>

                <StackPanel>
                    <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding FullName}"/>
                    <TextBlock
                    FontSize="10"
                    Text="{Binding PhoneNumber}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>


    </Window.Resources>

    <e:Interaction.Triggers>
        <e:EventTrigger EventName="Closing">
            <e:InvokeCommandAction Command="{Binding SaveInFileCommand}"/>
        </e:EventTrigger>
    </e:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F8F8F8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label  
                    Grid.Row="0"
                    Content="Find:" 
                    HorizontalAlignment="Left" 
                    Width="40"/>

                <TextBox 
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    Margin="40,0,0,0"/>

                <ListBox
                    Grid.Row="1"
                    Height="Auto"
                    ItemsSource="{Binding Contacts}"
                    SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
                    ItemTemplate="{StaticResource ContactDataTemplate}"/>
            </Grid>
        </Border>

        <GridSplitter 
            Grid.Column="1" 
            Background="White"
            HorizontalAlignment="Center"
            Width="3"/>

        <Grid Grid.Column="0" Grid.Row="1" Background="#F8F8F8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Add" 
                    Command="{Binding AddCommand}"
                    Height="25" 
                    Margin="8,3,3,8"
                    Grid.Column="0"/>

            <Button Content="Edit" 
                    Command="{Binding EditCommand}"
                    Height="25" 
                    Margin="3,3,3,8"
                    Grid.Column="1"/>

            <Button Content="Remove" 
                    Command="{Binding RemoveCommand}"
                    Height="25" 
                    Margin="3,3,8,8"
                    Grid.Column="2"/>
        </Grid>

        <Grid Grid.Column="2" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1">
                <controls:ContactControl 
                    DataContext="{Binding ActiveContact}" 
                    IsReadOnly="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                    Grid.Row="0" 
                    Width="Auto"/>
            </StackPanel>

            <Button Grid.Column="1" 
                    Grid.Row="1"
                    Content="Apply" 
                    Command="{Binding ApplyChangesCommand}"
                    Height="25" 
                    Width="75" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Margin="112,50,0,0"
                    Visibility="{Binding IsApplyVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</Window>